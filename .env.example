# Copy to .env (never commit .env). Secrets stay server-side; nothing here may be NEXT_PUBLIC_.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://deepresearch:deepresearch@localhost:5432/deepresearch
REDIS_URL=redis://localhost:6379
# Needed from M1
AUTH_SECRET=
# Production only: the public base URL (Auth.js rejects unknown hosts in production).
AUTH_URL=
# GitHub OAuth (optional until you create the app)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Dev/test ONLY. Ignored in production. Never set in deployed environments.
DEV_LOGIN=
# Needed from M2 (leave empty to use the fake server in tests)
ANTHROPIC_API_KEY=
# Needed from M5
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# Object storage (MinIO locally), needed from M4
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=deepresearch
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Directory for uploaded files (local storage driver). Defaults to ./.data/uploads
# UPLOAD_DIR=
